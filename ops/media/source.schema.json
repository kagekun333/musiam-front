{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:musiam:media:source:v1",
  "title": "MUSIAM Media OS V1 source recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source",
    "evidence",
    "channels",
    "cta"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "url",
        "date",
        "title"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^content/letters/[A-Za-z0-9_-]+\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^/letters/[A-Za-z0-9_-]+$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "authority",
          "scope",
          "excerpt",
          "line"
        ],
        "properties": {
          "kind": {
            "enum": [
              "quote",
              "fact"
            ]
          },
          "authority": {
            "enum": [
              "OWNER_SOURCE",
              "FACT"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "letter",
        "intelligence",
        "seo_article",
        "x",
        "threads",
        "instagram",
        "short_video",
        "newsletter"
      ],
      "properties": {
        "letter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "segments"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text",
                  "evidence_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "quote",
                      "fact",
                      "inference"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "intelligence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "segments"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text",
                  "evidence_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "quote",
                      "fact",
                      "inference"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "seo_article": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "segments"
          ],
          "properties": {
            "purpose": {
