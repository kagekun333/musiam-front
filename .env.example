GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# PWA Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:your@email.com

# VIP Metal Print production adapters (server-only; never use NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_METAL_PRINT_WEBHOOK_SECRET=whsec_REPLACE_ME
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME
# Vercel Marketplace uses these equivalent names; the adapter accepts either pair.
KV_REST_API_URL=https://REPLACE_ME.upstash.io
KV_REST_API_TOKEN=REPLACE_ME
METAL_PRINT_IDENTITY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Local operations only: HMACs private order/tracking references before evidence registration.
METAL_PRINT_EVIDENCE_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_RANDOM_SECRET
NEXT_PUBLIC_SITE_URL=http://localhost:3000
METAL_PRINT_OPS_ALERT_EMAIL=owner@example.com
