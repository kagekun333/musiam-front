                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "x": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "segments"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text",
                  "evidence_ids"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "quote",
                      "fact",
                      "inference"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "threads": {
