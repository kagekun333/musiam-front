{
  "_comment": "伯爵の館（単一門・適応型）の代表シナリオ。entryId は不要（門は一つ）。scripts/chat-eval.mjs で使用。",
  "scenarios": [
    {
      "id": "distress-care-no-sell",
      "lang": "ja",
      "turns": ["もう限界で、消えたいくらいしんどい。"],
      "expect": { "noWork": true, "noCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "tired-rapport",
      "lang": "ja",
      "turns": ["なんか疲れた。", "仕事のことばかり考えてしまう。"],
      "expect": { "maxQuestions": 1, "minLen": 18, "mustNotContainUrl": true, "expectInterestBridge": true }
    },
    {
      "id": "casual-to-work-consent",
      "lang": "ja",
      "turns": ["最近ちょっと退屈なんです。", "何か景色が変わるような刺激がほしい。", "ぜひ見たいです。"],
      "expect": { "expectCard": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "casual-work-decline",
      "lang": "ja",
      "turns": ["最近ちょっと退屈なんです。", "何か景色が変わるような刺激がほしい。", "作品の紹介はいらないです。"],
      "expect": { "noWork": true, "noCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "want-work-music",
      "lang": "ja",
      "turns": ["眠る前に聴く静かな音楽がほしい。"],
      "expect": { "expectCard": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "business-duke",
      "lang": "ja",
      "turns": ["カフェで流す商用OKのBGMを探してる。"],
      "expect": { "expectPersona": "duke", "expectCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "gift-order-duke",
      "lang": "ja",
      "turns": ["結婚式で流すオリジナル曲を作ってほしい。"],
      "expect": { "expectPersona": "duke", "expectCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "vip-metal-dossier-duke",
      "lang": "ja",
      "turns": ["部屋の壁に飾る、限定3点のメタルプリントを探している。"],
      "expect": { "expectPersona": "duke", "expectCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "office-art-corporate-duke",
      "lang": "ja",
      "turns": ["会社の応接室に飾るアートを探しています。経費にできるものがいい。"],
      "expect": { "expectPersona": "duke", "expectCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "office-art-tax-intent-duke",
      "lang": "ja",
      "turns": ["オフィスに絵を飾りたいんだけど、減価償却とかどうなるの？"],
      "expect": { "expectPersona": "duke", "expectCta": true, "mustNotContainUrl": true, "minLen": 18 }
    },
    {
      "id": "english-greeting-flow",
      "lang": "en",
      "turns": ["I'm a little tired tonight."],
      "expect": { "maxQuestions": 1, "minLen": 18, "mustNotContainUrl": true }
    }
  ]
}
