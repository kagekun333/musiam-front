      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href",
        "label",
        "evidence_id",
        "reason"
      ],
      "properties": {
        "href": {
          "type": "string",
          "pattern": "^/(?!/)"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
